+++ b/crates/qymcad/src/gui/selection_sync.rs
@@ -0,0 +1,23 @@
+//! Keep selection attached to the sketch currently being edited.
+use qymcad_core::model::Project;
+use qymcad_ui_state::{Sel, SketchSelection, SketchSession, Workbench};
+
+pub(super) fn follow(project: &Project, session: &mut SketchSession, selection: &mut Sel, workbench: &mut Workbench, elements: &mut SketchSelection) {
+    match qymcad_ui_state::edit_si(project, session) {
+        Some(si) => {
+            *selection = Sel::Sketch(si);
+            *workbench = Workbench::Sketch;
+        }
+        None => session.editing = None,
+    }
+    if let Sel::Sketch(si) = *selection {
+        if let Some(sketch) = project.sketches.get(si) {
+            if session.last != Some(sketch.id) {
+                elements.clear();
+            }
+            session.last = Some(sketch.id);
+        }
+    } else {
+        elements.clear();
+    }
+}
