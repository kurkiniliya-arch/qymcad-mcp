diff --git a/crates/qymcad/src/gui/live_bridge.rs b/crates/qymcad/src/gui/live_bridge.rs
new file mode 100644
--- /dev/null
+++ b/crates/qymcad/src/gui/live_bridge.rs
@@ -0,0 +1,236 @@
+//! Local file transactions against the document shown by the window.
+use qymcad_ui_state::{PartCtx, Settings, doc_key};
+use serde::Deserialize;
+use serde_json::{Value, json};
+use std::path::{Path, PathBuf};
+use std::time::{Duration, Instant, SystemTime, UNIX_EPOCH};
+
+#[derive(Clone)]
+struct Endpoint {
+    root: Option<PathBuf>,
+    polled: Instant,
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Request {
+    op: String,
+    deadline_ms: u64,
+    revision: Option<String>,
+    document: Option<String>,
+}
+
+#[derive(Default)]
+pub(super) struct Applied {
+    document: Option<String>,
+    active_path: Option<Vec<u64>>,
+}
+
+impl Applied {
+    pub(super) fn finish(self, project_path: &mut Option<String>, set: &mut Settings, active_path: &mut Vec<u64>) {
+        if let Some(path) = self.document {
+            if path.is_empty() {
+                *project_path = None;
+            } else {
+                super::set_project_path(project_path, set, path);
+            }
+        }
+        if let Some(path) = self.active_path {
+            *active_path = path;
+        }
+    }
+}
+
+pub(super) fn bind(ctx: &egui::Context, root: PathBuf) {
+    ctx.data_mut(|d| d.insert_temp(egui::Id::new("local-document-bridge"), Endpoint { root: Some(root), polled: Instant::now() - Duration::from_secs(1) }));
+}
+
+fn revision(pc: &PartCtx<'_>) -> String {
+    format!("{:016x}", doc_key(pc.project))
+}
+
+fn write_reply(folder: &Path, reply: Value) -> Result<(), String> {
+    let tmp = folder.join("response.tmp");
+    std::fs::write(&tmp, serde_json::to_vec(&reply).map_err(|e| e.to_string())?).map_err(|e| e.to_string())?;
+    std::fs::rename(tmp, folder.join("response.json")).map_err(|e| e.to_string())
+}
+
+fn snapshot(pc: &PartCtx<'_>, folder: &Path) -> Result<(), String> {
+    let _gate = qymcad_kernel::kernel_gate();
+    let mut blobs = pc.live.blobs.clone();
+    for (id, shape) in &pc.live.shapes {
+        if let Some(bytes) = shape.to_brep_bytes() {
+            blobs.insert(*id, bytes);
+        }
+    }
+    let breps: Vec<_> = blobs.into_iter().collect();
+    let target = folder.join("snapshot.qcad");
+    qymcad_io::save_project_with_brep(pc.project, &target.to_string_lossy(), &breps)
+}
+
+fn apply(pc: &mut PartCtx<'_>, folder: &Path) -> Result<(), String> {
+    let path = folder.join("candidate.qcad");
+    if path.symlink_metadata().map_err(|e| e.to_string())?.is_symlink() {
+        return Err("Candidate must be a regular local file".into());
+    }
+    if std::fs::metadata(&path).map_err(|e| e.to_string())?.len() > 100 * 1024 * 1024 {
+        return Err("Candidate exceeds 100 MB".into());
+    }
+    let loaded = qymcad_io::load_project_with_brep(&path.to_string_lossy())?;
+    let mut shapes = std::collections::HashMap::new();
+    {
+        let _gate = qymcad_kernel::kernel_gate();
+        for (id, bytes) in &loaded.breps {
+            let shape = qymcad_kernel::Shape::from_brep_bytes(bytes).ok_or("Invalid cached B-rep")?;
+            if !shape.is_valid() {
+                return Err("Invalid solid in candidate".into());
+            }
+            shapes.insert(*id, shape);
+        }
+    }
+    qymcad_ui_state::begin_edit(pc.edits, pc.project, qymcad_i18n::tr("undo-edit"));
+    // Keep source bytes for undo and redo, including document replacement.
+    for source in &pc.project.sources {
+        pc.live.shelved_sources.insert(source.id, source.data.clone());
+    }
+    pc.live.shelved.extend(std::mem::take(&mut pc.live.shapes));
+    *pc.project = loaded.project;
+    pc.live.shapes = shapes;
+    pc.live.blobs = loaded.breps.into_iter().collect();
+    pc.live.faces = pc.project.bodies.iter().map(|b| (b.id, b.faces.clone())).collect();
+    pc.live.ready = true;
+    pc.live.tried_rev = None;
+    pc.live.wait = None;
+    *pc.sel = qymcad_ui_state::Sel::None;
+    *pc.gsel = Default::default();
+    pc.sketch_ses.editing = None;
+    pc.sketch_ses.last = None;
+    pc.params_seen.clear();
+    *pc.mode_3d = true;
+    pc.win.show_start(false);
+    qymcad_part::resync_after_topology_change(pc);
+    qymcad_ui_state::commit_edit(&mut pc.rebuild());
+    Ok(())
+}
+
+fn execute(request: &Request, folder: &Path, pc: &mut PartCtx<'_>) -> Result<Applied, String> {
+    let now = SystemTime::now().duration_since(UNIX_EPOCH).map_err(|e| e.to_string())?.as_millis();
+    if now > request.deadline_ms as u128 {
+        return Err("Request expired without changing the document".into());
+    }
+    let mut applied = Applied::default();
+    match request.op.as_str() {
+        "snapshot" => snapshot(pc, folder)?,
+        "apply" | "undo" | "redo" => {
+            if request.revision.as_deref() != Some(&revision(pc)) {
+                return Err("Document changed in the window; inspect it and retry the operation".into());
+            }
+            if request.op == "apply" {
+                apply(pc, folder)?;
+                applied.document = request.document.clone();
+                applied.active_path = Some(qymcad_ui_state::context_path_to(pc.project, pc.project.active_component.unwrap_or(pc.project.root)));
+            } else {
+                applied.active_path = qymcad_ui_state::step_through_history(&mut pc.rebuild(), request.op == "redo");
+                if applied.active_path.is_none() {
+                    return Err("No history step is available".into());
+                }
+            }
+        }
+        "fit" => pc.cam.init = false,
+        "status" | "screenshot" => {}
+        _ => return Err("Unknown live operation".into()),
+    }
+    Ok(applied)
+}
+
+pub(super) fn tick(ctx: &egui::Context, pc: &mut PartCtx<'_>, blocked: bool) -> Applied {
+    let key = egui::Id::new("local-document-bridge");
+    let mut endpoint =
+        ctx.data_mut(|d| d.get_temp::<Endpoint>(key)).unwrap_or_else(|| Endpoint { root: std::env::var_os("QYMCAD_LIVE_DIR").map(PathBuf::from), polled: Instant::now() - Duration::from_secs(1) });
+    let Some(root) = endpoint.root.clone() else {
+        ctx.data_mut(|d| d.insert_temp(key, endpoint));
+        return Applied::default();
+    };
+    ctx.input(|i| {
+        for event in &i.events {
+            if let egui::Event::Screenshot { user_data, image, .. } = event {
+                let Some(folder) = user_data.data.as_ref().and_then(|d| d.downcast_ref::<PathBuf>()) else { continue };
+                if folder.parent() != Some(root.as_path()) || !folder.join("processing.json").is_file() {
+                    continue;
+                }
+                let reply =
+                    match super::color_image_to_png(image).ok_or("Screenshot encoding failed").and_then(|png| std::fs::write(folder.join("window.png"), png).map_err(|_| "Screenshot write failed")) {
+                        Ok(()) => json!({"ok": true, "revision": revision(pc)}),
+                        Err(error) => json!({"ok": false, "error": error}),
+                    };
+                let _ = write_reply(folder, reply);
+            }
+        }
+    });
+    ctx.request_repaint_after(Duration::from_millis(250));
+    if endpoint.polled.elapsed() < Duration::from_millis(80) {
+        return Applied::default();
+    }
+    endpoint.polled = Instant::now();
+    ctx.data_mut(|d| d.insert_temp(key, endpoint));
+    let busy = blocked
+        || pc.regen.busy.is_some()
+        || pc.regen.regen_running()
+        || pc.regen.wanted
+        || pc.edits.open.is_some()
+        || pc.sketch_ses.editing.is_some()
+        || matches!(pc.armed, qymcad_ui_state::Armed::Command(_))
+        || ctx.egui_wants_keyboard_input()
+        || ctx.input(|i| i.pointer.any_down());
+    let Ok(entries) = std::fs::read_dir(&root) else { return Applied::default() };
+    for entry in entries.flatten() {
+        let name = entry.file_name().to_string_lossy().into_owned();
+        if name.len() != 32 || !name.bytes().all(|b| b.is_ascii_hexdigit()) || !entry.file_type().is_ok_and(|t| t.is_dir() && !t.is_symlink()) {
+            continue;
+        }
+        let folder = entry.path();
+        let file = folder.join("request.json");
+        if !file.is_file() || folder.join("response.json").exists() {
+            continue;
+        }
+        let result = std::fs::read(&file).map_err(|e| e.to_string()).and_then(|bytes| {
+            if bytes.len() > 16384 {
+                return Err("Request too large".into());
+            }
+            serde_json::from_slice::<Request>(&bytes).map_err(|e| e.to_string())
+        });
+        if std::fs::rename(&file, folder.join("processing.json")).is_err() {
+            continue;
+        }
+        let request = match result {
+            Ok(request) => request,
+            Err(error) => {
+                let _ = write_reply(&folder, json!({"ok": false, "error": error}));
+                continue;
+            }
+        };
+        if busy && request.op != "status" {
+            let _ = write_reply(&folder, json!({"ok": false, "error": "Window is busy: finish the active edit, dialog or rebuild, then retry"}));
+            continue;
+        }
+        match execute(&request, &folder, pc) {
+            Ok(applied) => {
+                if request.op == "screenshot" {
+                    ctx.send_viewport_cmd(egui::ViewportCommand::Screenshot(egui::UserData::new(folder)));
+                    return applied;
+                }
+                let _ = write_reply(
+                    &folder,
+                    json!({"ok": true, "revision": revision(pc), "busy": busy,
+                    "pid": std::process::id(), "protocol": 1, "undo_steps": pc.edits.undo.len(), "redo_steps": pc.edits.redo.len()}),
+                );
+                ctx.request_repaint();
+                return applied;
+            }
+            Err(error) => {
+                let _ = write_reply(&folder, json!({"ok": false, "error": error}));
+            }
+        }
+    }
+    Applied::default()
+}
diff --git a/crates/qymcad/src/gui/selection_sync.rs b/crates/qymcad/src/gui/selection_sync.rs
new file mode 100644
