@@ -0,0 +1,97 @@
+use qymcad::{Key, Machine, Modifiers, Session};
+use serde_json::{Value, json};
+use std::path::{Path, PathBuf};
+use std::time::{Duration, SystemTime, UNIX_EPOCH};
+
+fn folder(root: &Path, number: u64) -> PathBuf {
+    let path = root.join(format!("{number:032x}"));
+    std::fs::create_dir_all(&path).unwrap();
+    path
+}
+
+fn request(session: &mut Session, folder: &Path, operation: &str, revision: Option<&str>, deadline: u64) -> Value {
+    std::fs::write(
+        folder.join("request.json"),
+        serde_json::to_vec(&json!({"op": operation, "revision": revision,
+        "deadline_ms": deadline, "document": null}))
+        .unwrap(),
+    )
+    .unwrap();
+    for _ in 0..30 {
+        session.pause(Duration::from_millis(100));
+        if let Ok(bytes) = std::fs::read(folder.join("response.json")) {
+            return serde_json::from_slice(&bytes).unwrap();
+        }
+    }
+    panic!("The window did not answer {operation}");
+}
+
+fn candidate(path: &Path) {
+    let _gate = qymcad_kernel::kernel_gate();
+    let mut project = qymcad_core::model::Project::default();
+    project.new_empty_document();
+    let part = project.add_part("Live cylinder");
+    project.set_active_component(Some(part));
+    let body = project.add_cylinder(7.0, 19.0);
+    project.finish_base_body(body, 1);
+    let kernel = qymcad_kernel::OcctKernel::default();
+    let report = project.regenerate(&kernel);
+    assert!(report.errors.is_empty());
+    for (id, faces) in report.built {
+        project.set_body_faces(id, faces);
+    }
+    let breps: Vec<_> = kernel.shapes.borrow().iter().map(|(id, s)| (*id, s.to_brep_bytes().unwrap())).collect();
+    qymcad_io::save_project_with_brep(&project, &path.to_string_lossy(), &breps).unwrap();
+}
+
+#[test]
+fn live_window_transactions_and_keyboard_undo_share_one_document() {
+    let root = std::env::temp_dir().join(format!("qymcad-live-test-{}", std::process::id()));
+    std::fs::create_dir_all(&root).unwrap();
+    let home = root.join("home");
+    let endpoint = root.join("endpoint");
+    std::fs::create_dir_all(&endpoint).unwrap();
+    let mut session = Session::start_on(Machine { home, greeting: false, ..Default::default() });
+    session.budget(Duration::from_secs(20));
+    session.connect_local_bridge(endpoint.clone());
+    let original = session.document();
+    let deadline = (SystemTime::now().duration_since(UNIX_EPOCH).unwrap().as_millis() + 120_000) as u64;
+    let before = request(&mut session, &folder(&endpoint, 1), "snapshot", None, deadline);
+    assert_eq!(before["ok"], true);
+    assert!(endpoint.join(format!("{:032x}/snapshot.qcad", 1)).is_file());
+    let revision = before["revision"].as_str().unwrap();
+    let commit = folder(&endpoint, 2);
+    candidate(&commit.join("candidate.qcad"));
+    let done = request(&mut session, &commit, "apply", Some(revision), deadline);
+    assert_eq!(done["ok"], true, "{done}");
+    let changed = session.document();
+    assert!(changed.parts.iter().any(|p| p.name == "Live cylinder"));
+    assert!(changed.unsaved);
+    assert_eq!(changed.undo.len(), original.undo.len() + 1);
+    assert!(changed.features.iter().all(|f| f.error.is_none()));
+    let picture = session.snapshot();
+    assert!(picture.width > 100 && picture.height > 100);
+    assert!(picture.rgba.chunks_exact(4).any(|pixel| pixel[0] != pixel[1]));
+    std::fs::write(root.join("live-window.png"), picture.png()).unwrap();
+    let stale = folder(&endpoint, 3);
+    candidate(&stale.join("candidate.qcad"));
+    let rejected = request(&mut session, &stale, "apply", Some(revision), deadline);
+    assert_eq!(rejected["ok"], false);
+    assert_eq!(changed, session.document());
+    let expired = request(&mut session, &folder(&endpoint, 4), "undo", done["revision"].as_str(), 1);
+    assert_eq!(expired["ok"], false);
+    assert_eq!(changed, session.document());
+    session.chord(Modifiers::COMMAND, Key::Z);
+    assert_eq!(session.document().parts, original.parts);
+    let manual = request(&mut session, &folder(&endpoint, 5), "snapshot", None, deadline);
+    assert_ne!(manual["revision"], done["revision"]);
+    let redone = request(&mut session, &folder(&endpoint, 6), "redo", manual["revision"].as_str(), deadline);
+    assert_eq!(redone["ok"], true, "{redone}");
+    assert_eq!(session.document().parts, changed.parts);
+    let undo = request(&mut session, &folder(&endpoint, 7), "undo", redone["revision"].as_str(), deadline);
+    assert_eq!(undo["ok"], true, "{undo}");
+    assert_eq!(session.document().parts, original.parts);
+    let bad = request(&mut session, &folder(&endpoint, 8), "shell", None, deadline);
+    assert_eq!(bad["ok"], false);
+    println!("Preview: {}", root.join("live-window.png").display());
+}
